# ========================================
# NEW SEO-FRIENDLY URL ROUTING
# ========================================

# Exclude existing files and static assets
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ [NC]

# Exclude admin panel, assets, images, js, css, uploads
RewriteCond %{REQUEST_URI} !^/(admin|assets|images|js|css|uploads|includes|logs|cryptomusexample)/

# Route all SEO-friendly URLs to router.php
RewriteRule ^(.+)$ router.php?url=$1 [QSA,L]

# Güvenlik kuralları
<Files ".htaccess">
Order allow,deny
Deny from all
</Files>

# PHP hata raporlamayı kapat (production için)
php_flag display_errors Off
php_flag log_errors On

# Dosya yükleme limitleri
php_value upload_max_filesize 10M
php_value post_max_size 10M

# Güvenlik başlıkları
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# “ea-php81” paketini varsayılan “PHP” programlama dili olarak ayarlayın.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
