# SEO-Friendly URL Configuration
RewriteEngine On
RewriteBase /

# HTTPS değilse yönlendir
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ========================================
# 301 REDIRECTS - OLD URLs to SEO-Friendly URLs
# ========================================

# Static Page Redirects
RewriteRule ^guest_order_track\.php$ /siparis-takip [R=301,L]
RewriteRule ^sss\.php$ /sikca-sorulan-sorular [R=301,L]
RewriteRule ^hizmetler\.php$ /hizmetler [R=301,L]
RewriteRule ^iletisim\.php$ /iletisim [R=301,L]
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^kvvk\.php$ /kvkk [R=301,L]
RewriteRule ^login\.php$ /giris-yap [R=301,L]
RewriteRule ^register\.php$ /kayit-ol [R=301,L]
RewriteRule ^privacy\.php$ /gizlilik-politikasi [R=301,L]
RewriteRule ^sitemap\.xml$ /sitemap_dynamic.php [R=301,L]

# Category Redirects - hesaplar.php?category=X
