// Neon Postgres schema — ported from legacy MySQL (businesshesap.sql + SEO/admin columns)
// Do not run migrate against production without explicit approval.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  active
  inactive
}

enum DeliveryType {
  instant
  manual
}

enum OrderStatus {
  pending
  processing
  completed
  cancelled
}

enum DeliveryStatus {
  pending
  partial
  delivered
  failed
}

enum CryptoPaymentStatus {
  pending
  paid
  failed
  expired
  cancelled
}

enum TicketStatus {
  open
  in_progress
  waiting_customer
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum TicketReplyBy {
  customer
  admin
}

enum SessionInvalidatedBy {
  user
  admin
  security
  expired
}

enum BanType {
  permanent
  temporary
}

model User {
  id                   Int       @id @default(autoincrement())
  username             String    @unique @db.VarChar(50)
  email                String    @unique @db.VarChar(100)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  firstName            String    @map("first_name") @db.VarChar(50)
  lastName             String    @map("last_name") @db.VarChar(50)
  phone                String?   @db.VarChar(20)
  registrationIp       String?   @map("registration_ip") @db.VarChar(45)
  balance              Decimal   @default(0) @db.Decimal(10, 2)
  isActive             Boolean   @default(true) @map("is_active")
  isAdmin              Boolean   @default(false) @map("is_admin")
  emailVerified        Boolean   @default(false) @map("email_verified")
  verificationToken    String?   @map("verification_token") @db.VarChar(64)
  resetToken           String?   @map("reset_token") @db.VarChar(64)
  resetTokenExpires    DateTime? @map("reset_token_expires")
  loginAttempts        Int       @default(0) @map("login_attempts")
  lastLoginAttempt     DateTime? @map("last_login_attempt")
  lastLogin            DateTime? @map("last_login")
  deactivationReason   String?   @map("deactivation_reason")
  deactivatedUntil     DateTime? @map("deactivated_until")
  deactivatedBy        Int?      @map("deactivated_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  sessions             ActiveSession[]
  orders               Order[]
  supportTickets       SupportTicket[]
  activityLogs         UserActivityLog[]
  statusHistory        UserStatusHistory[]
  cryptoPayments       CryptoPayment[]
  popupAdViews         PopupAdView[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  seoSlug     String?   @unique @map("seo_slug") @db.VarChar(255)
  description String?
  icon        String    @db.VarChar(50)
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  accounts    Account[]

  @@map("categories")
}

model Account {
  id               Int           @id @default(autoincrement())
  categoryId       Int           @map("category_id")
  title            String        @db.VarChar(255)
  seoSlug          String?       @unique @map("seo_slug") @db.VarChar(500)
  description      String?
  price            Decimal       @db.Decimal(10, 2)
  oldPrice         Decimal?      @map("old_price") @db.Decimal(10, 2)
  stockQuantity    Int           @default(0) @map("stock_quantity")
  platform         String        @db.VarChar(50)
  accountType      String        @map("account_type") @db.VarChar(100)
  limitInfo        String?       @map("limit_info") @db.VarChar(255)
  features         String?
  technicalInfo    String?       @map("technical_info")
  status           AccountStatus @default(active)
  isVerified       Boolean       @default(false) @map("is_verified")
  isPremium        Boolean       @default(false) @map("is_premium")
  isFeatured       Boolean       @default(false) @map("is_featured")
  isSecure         Boolean       @default(false) @map("is_secure")
  instantDelivery  Boolean       @default(true) @map("instant_delivery")
  support247       Boolean       @default(true) @map("support_24_7")
  guarantee30Days  Boolean       @default(true) @map("guarantee_30_days")
  warrantyDays     Int           @default(30) @map("warranty_days")
  deliveryType     DeliveryType  @default(instant) @map("delivery_type")
  rating           Decimal       @default(0) @db.Decimal(2, 1)
  views            Int           @default(0)
  salesCount       Int           @default(0) @map("sales_count")
  location         String?       @db.VarChar(100)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  category         Category      @relation(fields: [categoryId], references: [id])
  featureRows      AccountFeature[]
  images           AccountImage[]
  stock            AccountStock[]
  paymentItems     PaymentItem[]

  @@index([categoryId])
  @@index([status])
  @@map("accounts")
}

model AccountFeature {
  id           Int     @id @default(autoincrement())
  accountId    Int     @map("account_id")
  featureName  String  @map("feature_name") @db.VarChar(255)
  featureValue String  @map("feature_value") @db.VarChar(255)

  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("account_features")
}

model AccountImage {
  id        Int      @id @default(autoincrement())
  accountId Int      @map("account_id")
  imagePath String   @map("image_path") @db.VarChar(500)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("account_images")
}

model AccountStock {
  id                 Int       @id @default(autoincrement())
  accountId          Int       @map("account_id")
  username           String    @db.VarChar(255)
  password           String    @db.VarChar(255)
  email              String?   @db.VarChar(255)
  emailPassword      String?   @map("email_password") @db.VarChar(255)
  totpSecret         String?   @map("totp_secret") @db.VarChar(255)
  accountCreatedDate DateTime? @map("account_created_date") @db.Date
  additionalInfo     String?   @map("additional_info")
  isSold             Boolean   @default(false) @map("is_sold")
  soldToUserId       Int?      @map("sold_to_user_id")
  orderId            Int?      @map("order_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  soldAt             DateTime? @map("sold_at")

  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order              Order?    @relation(fields: [orderId], references: [id])

  @@index([accountId, isSold])
  @@map("account_stock")
}

model ActiveSession {
  id                Int                   @id @default(autoincrement())
  sessionToken      String                @unique @map("session_token") @db.VarChar(128)
  userId            Int                   @map("user_id")
  ipAddress         String                @map("ip_address") @db.VarChar(45)
  userAgent         String                @map("user_agent")
  deviceFingerprint String                @map("device_fingerprint") @db.VarChar(64)
  createdAt         DateTime              @default(now()) @map("created_at")
  lastActivity      DateTime              @default(now()) @map("last_activity")
  expiresAt         DateTime              @map("expires_at")
  isActive          Boolean               @default(true) @map("is_active")
  invalidatedBy     SessionInvalidatedBy? @map("invalidated_by")
  invalidatedAt     DateTime?             @map("invalidated_at")
  loginLocation     String?               @map("login_location") @db.VarChar(100)
  deviceInfo        Json?                 @map("device_info")

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("active_sessions")
}

model ContactSetting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique @map("setting_key") @db.VarChar(100)
  settingValue String   @map("setting_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("contact_settings")
}

model CryptoPayment {
  id              Int                 @id @default(autoincrement())
  userId          Int?                @map("user_id")
  orderCode       String              @unique @map("order_id") @db.VarChar(20)
  paymentMethod   String              @default("cryptomus") @map("payment_method") @db.VarChar(30)
  isGuestOrder    Boolean             @default(false) @map("is_guest_order")
  email           String?             @db.VarChar(255)
  customerName    String?             @map("customer_name") @db.VarChar(255)
  phone           String?             @db.VarChar(30)
  shopierPaymentId String?            @map("shopier_payment_id") @db.VarChar(100)
  cryptomusUuid   String?             @map("cryptomus_uuid") @db.VarChar(36)
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("USD") @db.VarChar(10)
  network         String?             @db.VarChar(20)
  toCurrency      String?             @map("to_currency") @db.VarChar(10)
  paymentAmount   Decimal?            @map("payment_amount") @db.Decimal(18, 8)
  address         String?             @db.VarChar(255)
  paymentUrl      String?             @map("payment_url")
  status          CryptoPaymentStatus @default(pending)
  paymentStatus   String?             @map("payment_status") @db.VarChar(20)
  txid            String?             @db.VarChar(255)
  expiredAt       DateTime?           @map("expired_at")
  callbackData    String?             @map("callback_data")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  user            User?               @relation(fields: [userId], references: [id])
  order           Order               @relation(fields: [orderCode], references: [orderCode], onDelete: Cascade)
  items           PaymentItem[]

  @@index([userId])
  @@index([email])
  @@map("crypto_payments")
}

model CryptoSetting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique @map("setting_key") @db.VarChar(100)
  settingValue String?  @map("setting_value")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("crypto_settings")
}

model CryptoWebhookLog {
  id        Int      @id @default(autoincrement())
  payload   String
  headers   String?
  status    String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("crypto_webhook_logs")
}

model Faq {
  id         Int      @id @default(autoincrement())
  question   String   @db.VarChar(500)
  answer     String
  orderIndex Int      @default(0) @map("order_index")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

model IpBan {
  id          Int       @id @default(autoincrement())
  ipAddress   String    @map("ip_address") @db.VarChar(45)
  reason      String
  banType     BanType   @default(temporary) @map("ban_type")
  bannedUntil DateTime? @map("banned_until")
  bannedBy    Int       @map("banned_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  isActive    Boolean   @default(true) @map("is_active")

  @@index([ipAddress, isActive])
  @@map("ip_bans")
}

model IpLimitReset {
  id                 Int      @id @default(autoincrement())
  ipAddress          String   @map("ip_address") @db.VarChar(45)
  resetBy            Int      @map("reset_by")
  accountsBeforeReset Int     @default(0) @map("accounts_before_reset")
  reason             String?
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("ip_limit_resets")
}

model LegalPage {
  id              Int      @id @default(autoincrement())
  pageType        String   @unique @map("page_type") @db.VarChar(50)
  title           String   @db.VarChar(255)
  content         String
  metaDescription String?  @map("meta_description")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("legal_pages")
}

model Order {
  id             Int            @id @default(autoincrement())
  orderCode      String         @unique @map("order_id") @db.VarChar(20)
  userId         Int?           @map("user_id")
  productName    String         @map("product_name") @db.VarChar(255)
  category       String         @db.VarChar(100)
  quantity       Int
  unitPrice      Decimal        @map("unit_price") @db.Decimal(10, 2)
  totalPrice     Decimal        @map("total_price") @db.Decimal(10, 2)
  orderDate      DateTime       @default(now()) @map("order_date")
  status         OrderStatus    @default(pending)
  deliveryStatus DeliveryStatus @default(pending) @map("delivery_status")
  paymentMethod  String?        @map("payment_method") @db.VarChar(30)
  isGuestOrder   Boolean        @default(false) @map("is_guest_order")
  email          String?        @db.VarChar(255)
  customerName   String?        @map("customer_name") @db.VarChar(255)
  phone          String?        @db.VarChar(30)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user           User?          @relation(fields: [userId], references: [id])
  payment        CryptoPayment?
  deliveredAccounts OrderAccount[]
  reservedStock  AccountStock[]

  @@index([userId])
  @@index([status])
  @@index([email])
  @@map("orders")
}

model OrderAccount {
  id                 Int       @id @default(autoincrement())
  orderCode          String    @map("order_id") @db.VarChar(20)
  accountId          Int?      @map("account_id")
  username           String    @db.VarChar(255)
  password           String    @db.VarChar(255)
  email              String?   @db.VarChar(255)
  emailPassword      String?   @map("email_password") @db.VarChar(255)
  totpSecret         String?   @map("totp_secret") @db.VarChar(255)
  accountCreatedDate DateTime? @map("account_created_date") @db.Date
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")

  order              Order     @relation(fields: [orderCode], references: [orderCode])

  @@index([orderCode])
  @@map("order_accounts")
}

model PaymentItem {
  id         Int      @id @default(autoincrement())
  paymentId  Int      @map("payment_id")
  accountId  Int      @map("account_id")
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  account    Account       @relation(fields: [accountId], references: [id])
  payment    CryptoPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_items")
}

/// IP and e-mail based throttling for guest checkout and order tracking.
model GuestRateLimit {
  id           Int       @id @default(autoincrement())
  identifier   String    @db.VarChar(255)
  action       String    @db.VarChar(50)
  attemptCount Int       @default(1) @map("attempt_count")
  windowStart  DateTime  @default(now()) @map("window_start")
  blockedUntil DateTime? @map("blocked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([identifier, action])
  @@map("guest_rate_limits")
}

model PopupAdView {
  id          Int      @id @default(autoincrement())
  ipAddress   String   @map("ip_address") @db.VarChar(45)
  userId      Int?     @map("user_id")
  viewDate    DateTime @map("view_date") @db.Date
  viewCount   Int      @default(1) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  contentHash String?  @default("") @map("content_hash") @db.VarChar(64)
  visitorId   String?  @map("visitor_id") @db.VarChar(128)

  user        User?    @relation(fields: [userId], references: [id])

  @@index([viewDate])
  @@map("popup_ad_views")
}

model SiteSetting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique @map("setting_key") @db.VarChar(100)
  settingValue String?  @map("setting_value")
  settingType  String?  @map("setting_type") @db.VarChar(255)
  description  String?
  category     String   @default("general") @db.VarChar(50)
  orderIndex   Int      @default(0) @map("order_index")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model SupportTicket {
  id          Int            @id @default(autoincrement())
  ticketCode  String         @unique @map("ticket_id") @db.VarChar(20)
  userId      Int            @map("user_id")
  orderCode   String         @map("order_id") @db.VarChar(20)
  subject     String         @db.VarChar(255)
  message     String
  status      TicketStatus   @default(open)
  priority    TicketPriority @default(medium)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  lastReplyAt DateTime?      @map("last_reply_at")
  lastReplyBy TicketReplyBy? @map("last_reply_by")

  user        User           @relation(fields: [userId], references: [id])
  replies     TicketReply[]

  @@unique([orderCode])
  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model TicketReply {
  id          Int      @id @default(autoincrement())
  ticketCode  String   @map("ticket_id") @db.VarChar(20)
  userId      Int?     @map("user_id")
  adminId     Int?     @map("admin_id")
  message     String
  isAdminReply Boolean @default(false) @map("is_admin_reply")
  createdAt   DateTime @default(now()) @map("created_at")

  ticket      SupportTicket @relation(fields: [ticketCode], references: [ticketCode], onDelete: Cascade)

  @@index([ticketCode])
  @@map("ticket_replies")
}

model UserActivityLog {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  activityType String   @map("activity_type") @db.VarChar(50)
  description  String?
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_activity_log")
}

model UserStatusHistory {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  oldStatus String?  @map("old_status") @db.VarChar(50)
  newStatus String   @map("new_status") @db.VarChar(50)
  reason    String?
  changedBy Int?     @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_status_history")
}
